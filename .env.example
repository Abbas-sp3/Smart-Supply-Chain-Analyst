# ==============================================================================
# Smart Supply Chain Analyst (SSCA) — Environment Configuration Template
# Copy this file to .env.local and populate with your API credentials:
#   cp .env.example .env.local
# DO NOT commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM INFERENCE ENGINES
# ------------------------------------------------------------------------------

# Groq — Primary AI Engine (LLaMA 3.3 70B & LLaMA 3.1 8B)
# Powers the 5-module Geopolitical Intelligence RAG pipeline
# [REQUIRED] Get your free key at: https://console.groq.com/
GROQ_API_KEY=gsk_...

# Groq — Dedicated Key for Interactive RAG Assistant ("Ask Intelligence")
# [RECOMMENDED] Separate key to prevent quota contention with report generation
GROQ_API_KEY_RAG=gsk_...

# Groq — Dedicated Key for Command Center Situation Summaries
# [RECOMMENDED] Separate key for live situational briefing generation
GROQ_API_KEY_COMMAND_CENTER=gsk_...

# Groq — Secondary / Failover Key
# [OPTIONAL] Used automatically if primary key hits rate/token ceilings
GROQ_API_KEY_2=gsk_...

# Google Gemini — Fallback LLM Engine (Gemini 2.5 Flash)
# [RECOMMENDED] Automatic seamless failover when Groq rate limits are encountered
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AI...

# ------------------------------------------------------------------------------
# 2. REAL-TIME DATA SOURCES & TELEMETRY
# ------------------------------------------------------------------------------

# AISStream — Live Global Maritime Telemetry (WebSocket)
# Powers real-time vessel tracking, choke point density, and tanker monitoring
# [RECOMMENDED] Get a free API key at: https://aisstream.io/
AISSTREAM_API_KEY=

# NewsAPI — Live Geopolitical & Trade Disruption News
# Feeds the real-time signal collection and OSINT pipeline (uses mock data if absent)
# [OPTIONAL] Get a free key at: https://newsapi.org/
NEWS_API_KEY=

# NewsAPI — Secondary Key for Procurement & Corridor Analysis
# [OPTIONAL] Spreads request quota across modules
NEWS_API_KEY_2=

# EIA (U.S. Energy Information Administration) — Live Crude Oil Spot Pricing
# Powers Brent / WTI spot benchmark feeds in the Energy Procurement module
# [OPTIONAL] Get a free key at: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# API Ninjas — Live Energy Commodity Spot Prices
# Powers live LNG, Coal, and Natural Gas tracking
# [OPTIONAL] Get a free key at: https://api-ninjas.com/
API_NINJAS_KEY=

# OpenSky Network — Military & Civil Aviation Telemetry (OAuth)
# Feeds airspace disruption signals into the geopolitical intelligence engine
# [OPTIONAL] Register at: https://opensky-network.org/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 3. SIMULATION ENGINE & SYSTEM SETTINGS
# ------------------------------------------------------------------------------

# Python Monte Carlo Tree Search (MCTS) Risk Server URL
# [OPTIONAL] Default is http://localhost:8787 (launched via `npm run dev:full` or `npm run mc`)
MONTE_CARLO_SERVER_URL=http://localhost:8787

# Intelligence Report In-Memory Cache TTL (milliseconds)
# [OPTIONAL] Default: 1800000 (30 minutes) | Demo / Presentation: 14400000 (4 hours)
INTELLIGENCE_CACHE_TTL_MS=1800000
